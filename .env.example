# MongoDB connection string (use TLS, e.g. mongodb+srv://USER:PASSWORD@HOST/DB)
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/DB_NAME

# Random string, at least 32 characters (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=

# Admin account created on first start when no admin exists (password: 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password given to judges created by `npm run seed` (test data only)
SEED_JUDGE_PASSWORD=

PORT=3000
NODE_ENV=development
